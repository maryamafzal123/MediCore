# Free key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here

# Format: provider:model
#   groq:llama-3.3-70b-versatile      (default, free, fast)
#   google_genai:gemini-2.5-flash     (needs GOOGLE_API_KEY)
LLM_MODEL=groq:llama-3.3-70b-versatile
# GOOGLE_API_KEY=your_gemini_key_here

# Where the .NET API runs
MEDICORE_API_URL=http://localhost:5136

# Hospital timezone offset from UTC (Pakistan = 5). Must match the .NET appsettings.
HOSPITAL_UTC_OFFSET_HOURS=5

# RAG: "embeddings" (fastembed, downloads a ~130MB model once) or "keyword" (BM25, no download)
RAG_MODE=embeddings
